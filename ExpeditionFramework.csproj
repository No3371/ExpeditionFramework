<Project Sdk="Microsoft.NET.Sdk">

  <!-- The in-game self-test buttons are left out of ordinary builds; -p:SelfTests=true puts them in the debug panel. -->
  <PropertyGroup Condition="'$(SelfTests)' == 'true'">
    <DefineConstants>$(DefineConstants);SELFTEST</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ExpeditionFramework</AssemblyName>
    <RootNamespace>ExpeditionFramework</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GameManaged>..\..\Probably Stolen_Data\Managed\</GameManaged>
    <InstallDir>..\..\Mods\ExpeditionFramework\</InstallDir>
    <!-- The installed ZoH Framework api, copied as is: every mod shares the first copy the game loads, so it is never rebuilt here. -->
    <ZohApi>..\..\Mods\ZohFramework\ZohFramework.Api.dll</ZohApi>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="api\ExpeditionFramework.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(GameManaged)0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameManaged)UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ZohFramework.Api"><HintPath>$(ZohApi)</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <Target Name="CheckZohApi" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(ZohApi)')">
    <Error Text="ZohFramework.Api.dll not found at $(ZohApi). Install ZoH Framework into Mods\ZohFramework\ or pass -p:ZohApi=&lt;path to its ZohFramework.Api.dll&gt;." />
  </Target>

  <Target Name="InstallMod" AfterTargets="Build">
    <ItemGroup>
      <Localization Include="Localization\*.csv" />
      <Packs Include="ExpeditionFramework\*.json" />
      <Sounds Include="Sounds\*.ogg" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath);$(OutDir)ExpeditionFramework.Api.dll;$(OutDir)ZohFramework.Api.dll;manifest.xml" DestinationFolder="$(InstallDir)" />
    <Copy SourceFiles="@(Localization)" DestinationFolder="$(InstallDir)Localization\" />
    <Copy SourceFiles="@(Packs)" DestinationFolder="$(InstallDir)ExpeditionFramework\" />
    <Copy SourceFiles="@(Sounds)" DestinationFolder="$(InstallDir)Sounds\" />
  </Target>

</Project>
